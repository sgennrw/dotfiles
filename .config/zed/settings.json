// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "ensure_final_newline_on_save": false,
  "remove_trailing_whitespace_on_save": false,
  "format_on_save": "on",
  "cli_default_open_behavior": "new_window",
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "default_profile": "write",
    "default_model": {
      "provider": "ollama",
      "model": "qwen3:8b",
      "enable_thinking": true,
    },
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "default",
        "model": "sonnet",
      },
      "type": "registry",
    },
    "opencode": {
      "default_config_options": {
        "model": "arv-gateway/claude-sonnet-4-6",
      },
      "type": "registry",
    },
    "gemini": {
      "default_mode": "autoEdit",
      "default_model": "auto",
      "type": "registry",
    },
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-5.6-terra",
        "mode": "read-only",
      },
      "type": "registry",
    },
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
    "oxlint": {
      "initialization_options": {
        "settings": {
          "configPath": null,
          "run": "onType",
          "disableNestedConfig": false,
          "fixKind": "safe_fix",
          "unusedDisableDirectives": "deny",
        },
      },
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": null,
          "run": "onSave",
        },
      },
    },
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy",
        },
      },
    },
  },
  "ui_font_family": ".ZedSans",
  "buffer_font_family": ".ZedMono",
  "use_system_path_prompts": false,
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "indent_guides": {
    "coloring": "fixed",
  },
  "colorize_brackets": true,
  "show_edit_predictions": false,
  "search": {
    "regex": false,
  },
  "project_panel": {
    "dock": "right",
  },
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  // "redact_private_values": true,
  "icon_theme": "Material Icon Theme",
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "GitHub Dark",
  },
  "code_actions_on_format": {
    "source.organizeImports": true,
    "source.fixAll.ruff": true,
    "source.fixAll.eslint": true,
  },
  "languages": {
    "Python": {
      "format_on_save": "off",
    },
    "TypeScript": {
      "format_on_save": "on",
    },
    "TSX": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false,
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt",
          },
        },
      ],
    },
  },
}
